<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>task_controllers</name>
  <version>0.0.0</version>
  <description>Nominal task controllers for Franka Panda manipulators (joint impedance, Cartesian impedance, joint velocity, move to start, wiping).</description>
  <maintainer email="jon.skerlj@gmail.com">Jon Skerlj</maintainer>
  <author email="jon.skerlj@gmail.com">Jon Skerlj</author>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>multi_mode_control_msgs</depend>
  <depend>franka_hardware</depend>
  <depend>franka_semantic_components</depend>
  <depend>reflex_controllers</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
