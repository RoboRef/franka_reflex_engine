<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>reflex_bringup</name>
  <version>0.0.0</version>
  <description>Launch files and YAML configurations for running the franka_reflex_engine
    on real Franka Panda hardware and in simulation.</description>
  <maintainer email="jon.skerlj@gmail.com">Jon Skerlj</maintainer>
  <author email="jon.skerlj@gmail.com">Jon Skerlj</author>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>franka_description</exec_depend>
  <exec_depend>franka_hardware</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>reflex_mc_impl</exec_depend>
  <exec_depend>reflex_controllers</exec_depend>
  <exec_depend>task_controllers</exec_depend>
  <exec_depend>panda_motion_generators</exec_depend>
  <exec_depend>franka_gripper</exec_depend>
  <exec_depend>franka_robot_state_broadcaster</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>franka_msgs</exec_depend>
  <exec_depend>multi_mode_control_msgs</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
