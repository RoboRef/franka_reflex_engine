<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>reflex_engine</name>
  <version>0.0.0</version>
  <description>Safety state-machine library for Franka Panda robots. Provides
    SimpleReflexEngine (contact detection, joint-limit monitoring, haptic
    gesture recovery) and the PandaContactChecker.</description>
  <maintainer email="jon.skerlj@gmail.com">Jon Skerlj</maintainer>
  <author email="jon.skerlj@gmail.com">Jon Skerlj</author>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>franka_hardware</depend>
  <depend>franka_msgs</depend>
  <depend>hardware_interface</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>reflex_controllers</depend>
  <depend>multi_mode_control_msgs</depend>
  <depend>rclcpp</depend>
  <depend>std_srvs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
